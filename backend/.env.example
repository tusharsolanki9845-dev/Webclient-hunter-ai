# WebClient Hunter AI — Backend Environment Variables
# Copy to .env for local development. Never commit real credentials.

PORT=3001
NODE_ENV=development
# Set true only behind a deliberately public demo deployment.
DEMO_MODE_ENABLED=false
# Set true on a platform that terminates TLS and forwards the real client IP (for example, Render).
TRUST_PROXY=false

# Supabase — use the project URL and public anon/publishable key. Every protected
# request is verified with the user bearer token and constrained by database RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInJlZiI6Ij...kpXVCJ9...

# OpenAI — server-side only.
OPENAI_API_KEY=sk-proj-...
OPENAI_OUTREACH_MODEL=gpt-4o-mini

# Comma-separated production frontend origins. Do not use * when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Rate limits per 15-minute window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
AUDIT_RATE_LIMIT_MAX=20
OUTREACH_RATE_LIMIT_MAX=10
